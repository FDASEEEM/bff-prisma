PORT=3010
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
# Desactivar CORS en producción cuando API Gateway maneja CORS
ENABLE_CORS=true

# Google OAuth via Cognito Hosted UI
# URL a la que Cognito redirige con el code tras el login de Google
GOOGLE_CALLBACK_URL=http://localhost:3010/api/auth/google/callback
# URL del front al que el BFF redirige con los tokens (fragment)
FRONT_URL=http://localhost:3002

USERS_SERVICE_URL=http://localhost:3001
ADMINPANEL_SERVICE_URL=http://localhost:3004
PERFIL_SERVICE_URL=http://localhost:3005
DOCS_SERVICE_URL=http://localhost:3000
CHAT_SERVICE_URL=http://localhost:3000
